[Unit]
Description=taskutil daily checks: ~/.task and mirrors current, taskrc includes resolve

[Service]
Type=oneshot
ExecStart=%h/.local/bin/taskutil stale --notify
ExecStart=%h/.local/bin/taskutil config check --notify
# Exit 1 (warnings) is the point of the check, not a failure of the unit.
SuccessExitStatus=1 2
